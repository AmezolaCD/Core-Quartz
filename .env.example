# Core Quartz · variables del servidor. Copiar a .env (nunca se sube a git).
PORT=4000
CQ_BASE_PATH=/portal
DATABASE_URL=postgres://usuario:contraseña@host:5432/postgres
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CQ_SSO_SECRETO=
CQ_CDH_INTERNO=http://cdh:3000/cdh
