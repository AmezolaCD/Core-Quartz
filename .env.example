# Core Quartz · variables del servidor. Copiar a .env (nunca se sube a git).
#
# Para el despliegue con Docker, el .env vive en `deploy/`:
#   cp .env.example deploy/.env
#
# Todo lo de aquí es de SERVIDOR. Ni la service_role ni DATABASE_URL ni el
# secreto del SSO llegan nunca al navegador (invariante §5).

# ---- El shell ----
PORT=4000
CQ_BASE_PATH=/portal
CQ_BASE_PATH_CDH=/cdh

# ---- Postgres (el mismo de Supabase que usa el CRM, esquema `core`) ----
DATABASE_URL=postgres://usuario:contraseña@host:5432/postgres

# ---- Supabase Auth ----
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Puerta interna con el CDH (R4) ----
# El mismo valor en los dos lados. Vacío en el shell apaga `/api/sso/*`: más
# vale que la puerta no exista a que exista sin llave.
CQ_SSO_SECRETO=
CQ_CDH_INTERNO=http://cdh:3000/cdh
CQ_URL_INTERNA=http://shell:4000/portal

# ---- Dónde vive cada módulo (siembra `core.modulos.url_base`) ----
#
# OJO: sólo se siembran en la PRIMERA migración, con `on conflict do nothing`.
# Cambiarlas después NO actualiza las filas; hay que hacerlo con SQL. El
# procedimiento está en docs/DESPLIEGUE.md y `deploy/verificar.sh` lo revisa.
#
# El CRM vive en Vercel, en otro dominio: ABSOLUTA, o la entrada al CRM
# redirige dentro del propio portal y no funciona.
CQ_URL_CRM=https://core-quartz.vercel.app
# El CDH comparte origen con el portal detrás de Caddy: relativa.
CQ_URL_CDH=/cdh

# ---- El origen público (Caddy) ----
# El dominio que apunta a esta máquina. Sin comprar nada sirve
# <ip-con-guiones>.sslip.io. Con `localhost`, Caddy firma con su CA interna.
CQ_ORIGEN=

# ---- El CDH ----
# Su imagen se construye en SU repositorio (`docker compose build` allá).
CDH_IMAGEN=cdh-quartz:1.0.0
CDH_TZ=America/Tijuana
# Sólo se usa en el primer arranque, al sembrar habitaciones y usuarios.
CDH_SEED_PASSWORD=
